# ===== YT Chat GenAI - Frontend Environment Variables =====
# Copy this file to ".env" for local development.
#
# NOTE: Vite inlines every VITE_* value into the JavaScript bundle at BUILD
# time, so it is public. Never put an API key or secret in this file.

# Base URL of the backend API — origin only, NO trailing slash and NO /api
# (the client appends /api itself).
#
# Local development: leave this EMPTY. The Vite dev server proxies /api to
# http://localhost:5000 (see vite.config.js).
#
# Production (Vercel): set it in the Vercel dashboard, not here, to your
# Render URL — e.g. https://yt-chat-genai-api.onrender.com
# Changing it requires a redeploy, because the value is baked into the build.
VITE_API_BASE_URL=
