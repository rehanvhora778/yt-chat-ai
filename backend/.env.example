# ===== YT Chat GenAI - Backend Environment Variables =====
# Copy this file to ".env" and fill in your own values.

# Flask
# development | production. In production the app refuses to start with a
# missing MONGO_URI / LLM key or a placeholder SECRET_KEY / JWT_SECRET, and
# OTP codes are never echoed to the logs.
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# JWT Authentication
JWT_SECRET=change-this-jwt-secret-too
JWT_EXPIRY_HOURS=24

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=your-mongodb-atlas-connection-string
MONGO_DB_NAME=yt_chat_genai

# Groq API key — FREE, high limits, used for text generation + audio.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Groq retires models often - verify at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Auto-used when GROQ_MODEL hits a daily cap or becomes unavailable. Needs a
# high per-minute token limit to accept a full transcript.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# ---- Google Sign-In ----
# OAuth 2.0 Web client id from https://console.cloud.google.com/apis/credentials
# Must be the SAME value as the frontend's VITE_GOOGLE_CLIENT_ID: the backend
# verifies that every ID token was issued for this exact client, which is what
# stops a token minted for some other site being accepted here.
# Blank disables Google sign-in.
GOOGLE_CLIENT_ID=

# Google Gemini API key  (https://aistudio.google.com/app/apikey)
# Optional when GROQ_API_KEY is set. Used for embeddings if present; otherwise
# embeddings run locally (fastembed), so this can be left blank.
GOOGLE_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# FAISS index storage folder. A relative path is resolved against the backend
# folder. On Render this must point at a mounted persistent disk (e.g.
# /var/data/faiss_store) or the indexes are wiped on every redeploy and the
# affected videos have to be processed again. See DEPLOYMENT.md.
FAISS_STORE_PATH=faiss_store

# ---- YouTube proxy (deployment only — leave blank locally) ----
# YouTube blocks most cloud/datacenter IPs, so a video that processes fine on
# your machine can fail once deployed. Route YouTube traffic through a
# residential proxy to fix it: either Webshare credentials (rotating
# residential plan) or a full proxy URL from any other provider.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
YOUTUBE_PROXY_URL=

# Comma separated list of allowed frontend origins (CORS).
# In production this must be the deployed frontend origin, e.g.
#   CORS_ORIGINS=https://yt-chat-ai.vercel.app
# Origins only: no trailing slash, no path.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex, for origins that cannot be listed individually. Vercel gives
# every preview deployment its own hostname, so allowing previews needs a
# pattern. Leave blank in production unless you want previews to reach the API.
#   CORS_ORIGIN_REGEX=^https://yt-chat-ai-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# ---- Email (OTP delivery) ----
# Gmail: turn on 2-Step Verification, then create an APP PASSWORD at
# https://myaccount.google.com/apppasswords and paste the 16-character value
# below. Your normal Gmail password will NOT work and must not go here.
# Leave SMTP_USER/SMTP_PASSWORD blank to keep the dev fallback, which prints
# the code to the backend console instead of emailing it.
# ---- Preferred when deployed: an HTTP email API ----
# Render's FREE plan blocks outbound SMTP (ports 25, 465, 587), so a Gmail App
# Password cannot deliver anything from there — it fails with "Network is
# unreachable" no matter how correct it is. These APIs use HTTPS instead and
# are used in preference to SMTP whenever a key is present.
#
# Brevo: 300 emails/day free, and ONE verified sender address is enough — no
# domain of your own required. https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Resend: more generous, but the free tier only mails the account owner until
# you verify a domain you control. https://resend.com/api-keys
RESEND_API_KEY=
# The From address for every transport. Must be a sender you have verified
# with the provider above. Falls back to SMTP_FROM / SMTP_USER when blank.
MAIL_FROM=
MAIL_FROM_NAME=YT Chat GenAI

# ---- SMTP: works locally and on paid hosting, blocked on Render free ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=YT Chat GenAI
SMTP_USE_TLS=true

# ---- OTP behaviour ----
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# true = also require an emailed code on every login (signup-only by default).
OTP_ON_LOGIN=false
# DEV ONLY: print the code to the backend console when SMTP is unconfigured.
OTP_DEV_ECHO=true
